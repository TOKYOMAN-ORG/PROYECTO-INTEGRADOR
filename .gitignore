# Variables de entorno: nunca se versionan, excepto las plantillas .env.example
.env
.env.*
!.env.example

# Claves y certificados privados
*.pem
*.key
*.p12
*.jks

# OS
.DS_Store
Thumbs.db


# Documentación local ignorada por defecto, salvo las evidencias de los sprints:
# SCRUM-9 exige que las evidencias queden versionadas en docs/evidencias/
/docs/*
!/docs/evidencias
!/docs/postman
!/docs/patrones-de-diseno.md
!/docs/diseno-ui.md

