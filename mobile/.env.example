# Plantilla de variables de entorno de la app móvil (Expo).
# Copiar a `mobile/.env` (ignorado por git):
#   cp .env.example .env
#
# ATENCIÓN: toda variable EXPO_PUBLIC_* queda incluida en el bundle de la app y es visible
# para cualquiera que la instale. Nunca poner aquí secretos, claves ni contraseñas.

# URL base del backend. `localhost` solo funciona en el simulador de iOS o en web:
# - Emulador de Android: http://10.0.2.2:3000
# - Dispositivo físico: http://<IP-de-tu-equipo-en-la-red-local>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
