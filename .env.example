# Plantilla de variables de entorno para backend y Docker (PostgreSQL + Liquibase).
# Copiar a `.env` (ignorado por git) y reemplazar cada `change_me` por un valor propio:
#   cp .env.example .env
# Los valores de este archivo son de ejemplo y NO son reales.

# --- Base de datos (PostgreSQL) ---
# Host y puerto con los que el backend (ejecutado en tu máquina) se conecta a la base.
DB_HOST=localhost
# Puerto del host publicado por Docker. Cámbialo si 5432/5433 ya están ocupados en tu equipo.
DB_PORT=5433
DB_NAME=secureplan
DB_USER=change_me
DB_PASSWORD=change_me

# --- Backend (NestJS) ---
PORT=3000
# Secreto para firmar los JWT. Generar uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
